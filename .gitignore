# The rule here: anything the code regenerates stays out, anything needed to reproduce a run
# goes in. So source, configs-as-defaults and the dataset index files are tracked, while
# downloaded datasets, checkpoints, generated images/features and run outputs are not.

# ── System & IDE ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.env
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── Datasets (downloaded on first run) ────────────────────────────────────────
data/
datasets/
balanced_dataset/
*.tar.gz
*.zip

# ── Model checkpoints & weights ───────────────────────────────────────────────
*.pt
*.pth
*.ckpt
*.safetensors
checkpoints/
memory_checkpoints/
feature_ddpm_checkpoints/

# ── Run outputs (paths from pipeline_config.get_default_config) ───────────────
logs/
results/
prompts/
synthetic_features/
synthetic_images/
benchmark_results/
table_results/

# ── Run outputs (test / smoke configurations) ─────────────────────────────────
test_checkpoints/
test_memory/
test_memory_checkpoints/
test_features/
test_prompts/
test_images/
test_logs/
test_results/
_smoke_out/
_probe_out/

# ── Outputs from earlier experiment scripts ───────────────────────────────────
demo_memory_checkpoints/
demo_synthetic_images/
demo_clip_cache/
clip_cache/
full_option3_results/
option3_test_results/
option3_generated_images/
generated_images/
synthetic_cifar10_images/
option1_cifar10_images/
*_images/

# ── Generated configs ─────────────────────────────────────────────────────────
# The defaults live in pipeline_config.py; these are per-run snapshots written by run.py.
test_config.json
full_config_*.json
custom_config_*.json

# ── Reports, logs and figures produced by a run ───────────────────────────────
*.log
*.png
*.jpg
*.jpeg
final_report_*.json
tail_analysis_*.json
tail_class_analysis_*.json
results_visualization_*.json
training_summary.json
*_report.json
*_analysis.json
*_prompts.json
*_result.json
benchmark_summary.json
